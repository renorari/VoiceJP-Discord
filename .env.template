# Base URL
BASE_URL=
PORT=

# Discord Bot Token
DISCORD_BOT_TOKEN=

# Billing (optional: without these, only the free engines are used)

# PostgreSQL connection string (e.g. postgresql://user:password@localhost:5432/voicejp)
DATABASE_URL=
# Database for `npm test` (tests create and delete rows, so never point this at a real database)
# TEST_DATABASE_URL=

# Better Auth (Discord login for the dashboard)
# Random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Discord application OAuth2 (redirect URI: {BASE_URL}/api/auth/callback/discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Stripe (no webhook needed: payments are synced through the Stripe API)
STRIPE_SECRET_KEY=

# Operator details for the 特定商取引法に基づく表記 page (/tokushoho.html).
# Keep real personal information here (never commit it). If you fork this project and
# sell anything, fill in your own details and check the legal requirements for your case.
# Items left empty are shown as "disclosed without delay on request by e-mail", which only
# works if you really answer such requests (see the Consumer Affairs Agency's guidance).
# OPERATOR_NAME=
# OPERATOR_ADDRESS=
# OPERATOR_PHONE=
# OPERATOR_EMAIL=
# OPERATOR_INVOICE_NUMBER=

# Recordings (a subscriber benefit; needs ffmpeg with libopus and aac)
# RECORDINGS_DIR=./recordings

# OpenAI (paid speech recognition / synthesis)
OPENAI_API_KEY=
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OPENAI_SPEECH_MODEL=tts-1
# OPENAI_SPEECH_VOICE=alloy
