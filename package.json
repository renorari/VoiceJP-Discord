{
  "name": "voicejp-discord",
  "version": "3.0.0",
  "description": "VoiceJPは、通話の文字起こしやテキストの音声読み上げができる、通話専用BOTです。",
  "private": true,
  "homepage": "https://github.com/renorari/VoiceJP-Discord#readme",
  "bugs": {
    "url": "https://github.com/renorari/VoiceJP-Discord/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renorari/VoiceJP-Discord.git"
  },
  "keywords": [
    "TTS",
    "STT",
    "Discord",
    "Bot"
  ],
  "license": "GPL-3.0",
  "author": "Renorari",
  "type": "module",
  "main": "src/main.ts",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/vosk": "^0.3.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prisma": "^7.10.0",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@snazzah/davey": "^0.1.12",
    "better-auth": "^1.7.7",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "log4js": "^6.9.1",
    "openai": "^7.27.0",
    "opusscript": "^0.0.8",
    "pg": "^8.23.1",
    "prism-media": "^1.3.5",
    "sashimi-ui": "^2.1.0",
    "stripe": "^23.0.0",
    "vosk": "^0.3.39"
  },
  "scripts": {
    "start": "node src/main.ts",
    "setup": "node src/setup.ts",
    "test": "node --test --test-concurrency=1",
    "postinstall": "prisma generate && npm run setup",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#*.ts": "./src/*.ts",
    "#*.js": "./src/*.js",
    "#*.json": "./src/*.json",
    "#billing/*.ts": "./src/billing/*.ts"
  }
}
